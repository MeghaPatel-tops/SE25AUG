MIN() - returns the smallest value of a column
MAX() - returns the largest value of a column
COUNT() - returns the number of rows in a set
SUM() - returns the sum of a numerical column
AVG() - returns the average value of a numerical column

SELECT min(price) as MinPrice from product;
SELECT max(price) as MaxPrice from product;
SELECT sum(price) as TotalPrice from product;
SELECT avg(price) as AvgPrice from product;
SELECT count(pid) as catWiseTotal from product where catid=5;