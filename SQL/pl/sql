 DELIMITER $$
 CREATE PROCEDURE priceIncreseProduct()
 BEGIN
 DECLARE cpid int;
 DECLARE cprice float;
 DECLARE done INT DEFAULT 0;
 
 DECLARE productCursor CURSOR FOR
 SELECT pid,price FROM product;
 
 DECLARE CONTINUE HANDLER FOR NOT FOUND
  SET done = 1;
  
  OPEN productCursor;
  ploop:LOOP
      FETCH productCursor into cpid,cprice;
      
      if done=1 THEN
         LEAVE ploop;
      END IF;   
      
      UPDATE product SET price=cprice+200 where pid=cpid;
  END LOOP;
  
  CLOSE productCursor;
  
  END  $$;
 
  